class: Rule
table: rules

fields:
   number: String?
   title: Texts?, relation(onUpdate=Cascade, onDelete=SetNull)
   description: Texts?, relation(onUpdate=Cascade, onDelete=SetNull)
   ruleCategory: RuleCategory?, relation(onUpdate=Cascade, onDelete=SetNull)
   displayOrder: int, default=0
indexes:
   rules_title_idx:
      fields: titleId
   rules_description_idx:
      fields: descriptionId
